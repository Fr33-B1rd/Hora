PORT=4318
# Optional. Without a key, the explicitly labeled local scenario parser is used.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4318/api/google/callback
# Optional private server-state directory; defaults to ./data
# DAYLIGHT_DATA_DIR=

# Public browser key: website restrictions + Maps JavaScript API only. Never reuse server key.
GOOGLE_MAPS_BROWSER_KEY=
# Optional custom map ID; DEMO_MAP_ID is used for local prototype markers.
GOOGLE_MAPS_MAP_ID=

# Optional overrides. Defaults to setup-voice.ps1 local installation.
# VOICE_PYTHON=C:/path/to/python.exe
# VOICE_MODEL_DIR=C:/path/to/whisper-small
# VOICE_DISABLED=1
